{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agreements.github.io/docx-platform-tests/registry/scenario-capabilities.schema.json",
  "title": "Scenario-to-capability mappings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "mappings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": { "type": "integer", "minimum": 1 },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "axis": {
      "enum": [
        "detect",
        "preserve",
        "parse",
        "validate",
        "generate",
        "edit",
        "compare",
        "acceptReject",
        "wordRoundtrip",
        "crossPlatform"
      ]
    },
    "oracleClass": {
      "enum": [
        "normative-schema",
        "normative-prose",
        "normative-microsoft-extension",
        "metamorphic-invariant",
        "observed-word-behavior",
        "cross-implementation-evidence",
        "serialization-specific"
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "capabilityId", "axis", "oracleClasses"],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "pattern": "^word(?:\\.[a-z][a-z0-9-]*){2,}$" },
        "axis": { "$ref": "#/$defs/axis" },
        "oracleClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/oracleClass" },
          "uniqueItems": true
        }
      }
    }
  }
}
