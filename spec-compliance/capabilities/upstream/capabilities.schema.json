{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agreements.github.io/docx-platform-tests/registry/capabilities.schema.json",
  "title": "DOCX capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "axis": {
      "enum": [
        "detect",
        "preserve",
        "parse",
        "validate",
        "generate",
        "edit",
        "compare",
        "acceptReject",
        "wordRoundtrip",
        "crossPlatform"
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "edition", "part", "section"],
      "properties": {
        "standard": { "const": "ECMA-376" },
        "edition": { "type": "integer", "minimum": 1 },
        "part": { "type": "integer", "minimum": 1 },
        "section": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" }
      }
    },
    "microsoftExtensionCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "section", "clauseTitle"],
      "properties": {
        "standard": { "const": "MS-DOCX" },
        "section": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
        "clauseTitle": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "family",
        "description",
        "standards",
        "dependencies",
        "applicableAxes",
        "packageParts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^word(?:\\.[a-z][a-z0-9-]*){2,}$" },
        "title": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "standards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "microsoftExtensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/microsoftExtensionCitation" },
          "default": []
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^word(?:\\.[a-z][a-z0-9-]*){2,}$" },
          "uniqueItems": true
        },
        "applicableAxes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/axis" },
          "uniqueItems": true
        },
        "packageParts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
