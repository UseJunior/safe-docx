{
  "schemaVersion": 1,
  "standard": "ECMA-376",
  "edition": 5,
  "part": 1,
  "scope": "WordprocessingML advanced revision records",
  "statuses": {
    "implemented": "safe-docx performs the named semantic operation and executable evidence is listed",
    "preservation-only": "safe-docx retains or structurally tolerates the markup without claiming its revision semantics",
    "conformance-gap": "safe-docx recognizes some of the surface but does not implement complete ECMA-376 semantics",
    "non-goal": "safe-docx intentionally does not implement or interpret this surface"
  },
  "storyScope": {
    "acceptReject": [
      "word/document.xml",
      "word/footnotes.xml",
      "word/endnotes.xml",
      "word/comments.xml",
      "word/glossary/document.xml"
    ],
    "preservationOnly": [
      "word/header*.xml",
      "word/footer*.xml",
      "word/styles.xml",
      "word/numbering.xml"
    ],
    "leanReads": [
      "word/document.xml",
      "word/footnotes.xml",
      "word/endnotes.xml"
    ],
    "leanClaim": "The compiled checker projects text and field markers only. It does not prove advanced revision-record semantics, property snapshots, range pairing, annotations, relationships, styles, numbering, headers, or footers."
  },
