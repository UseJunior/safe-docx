          "annotations": {
            "readOnlyHint": false,
            "destructiveHint": true
          }
        },
        {
          "name": "save",
          "description": "Save document. For DOCX: saves clean and/or tracked changes output. For Google Docs: checkpoint (default) returns revisionId, or snapshot exports as DOCX.",
