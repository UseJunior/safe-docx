{
  "name": "@usejunior/allure-test-factory",
  "version": "0.11.0",
  "description": "Shared Allure test helpers for vitest — BDD context, OpenSpec auto-inference, Prism.js highlighting",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./compat-reporter": {
      "types": "./src/compat-reporter.d.ts",
      "default": "./src/compat-reporter.js"
    },
    "./report-patches": {
      "types": "./src/report-patches.d.ts",
      "default": "./src/report-patches.js"
    }
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run"
  },
  "files": [
    "src/",
    "NOTICE"
  ],
  "peerDependencies": {
    "fast-xml-parser": ">=4.0.0",
    "prismjs": ">=1.29.0",
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "prismjs": {
      "optional": false
    },
    "fast-xml-parser": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
