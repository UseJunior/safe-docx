{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/testing/**/*",
    "src/debug/**/*",
    "src/benchmark/**/*",
    "src/integration/strategy-differential-fixtures.ts",
    "src/integration/strategy-differential-harness.ts"
  ]
}
